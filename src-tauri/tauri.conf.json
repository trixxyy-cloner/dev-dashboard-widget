{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Dashboard",
  "version": "0.1.0",
  "identifier": "com.sonny.devdashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dev Dashboard",
        "width": 380,
        "height": 640,
        "minWidth": 320,
        "minHeight": 300,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
